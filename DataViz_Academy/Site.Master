<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="DataViz_Academy.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DataViz Academy - Interactive Learning Portal</title>
    
    <link rel="stylesheet" href="style.css">
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <div style="display: flex; width: 100%; min-height: 100vh; margin:0; padding:0;">
            
            <%-- SIDEBAR NAVIGATION FRAME --%>
            <aside>
                <div class="sidebar-brand">DataViz Academy</div>
                
                <%-- FIXED: Added a distinct ID and localized fallback layout styling for the greeting block --%>
                <div id="roleIndicator" class="role-indicator role-guest" style="padding: 8px 12px; background: rgba(255,255,255,0.05); border-radius: 4px; font-size: 0.85rem; font-weight: 500; margin-bottom: 16px; color: #cbd5e1; transition: all 0.3s ease;">
                    Guest Account
                </div>
                
                <nav>
                    <ul>
                        <li><a href="Home.aspx">Home Workspace</a></li>
                        <li><a href="Profile.aspx">My Profile Dashboard</a></li>
                        <li><a href="Assessment.aspx">Interactive Course Modules</a></li>
                        <li><a href="Forum.aspx">Community Hub Forum</a></li>
                        <li><a href="Resources.aspx">External Documentation</a></li>
                        <li><a href="About.aspx">About Project Initiatives</a></li>
                        
                        <%-- VISUAL SEPARATOR LINE --%>
                        <hr id="navSeparator" style="border: 0; border-top: 1px solid rgba(255,255,255,0.1); margin: 12px 0;" />
                        
                        <%-- DEDICATED PORTAL LOGIN ACTION TAB (Hidden dynamically via JavaScript upon login) --%>
                        <li id="navLoginItem" style="background: rgba(99, 102, 241, 0.15); border-left: 3px solid #6366f1; border-radius: 4px;">
                            <a href="Auth.aspx" style="color: #a5b4fc; font-weight: 600; padding-left: 12px;">🔒 Portal Login</a>
                        </li>

                        <%-- ADDED: DYNAMIC LOG OUT ACTION TAB (Displayed only when logged in) --%>
                        <li id="navLogoutItem" style="display: none; background: rgba(244, 63, 94, 0.1); border-left: 3px solid #f43f5e; border-radius: 4px;">
                            <a href="#" onclick="handleUserLogout(); return false;" style="color: #fca5a5; font-weight: 600; padding-left: 12px;">🚪 Log Out Session</a>
                        </li>
                    </ul>
                </nav>
            </aside>

            <%-- MAIN FRAME CONTEXT ROW VIEW CONTAINER --%>
            <main style="margin-left: 260px; padding: 40px; width: calc(100% - 260px); background: var(--primary-bg); flex-grow: 1;">
                
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>

                <div id="forumCreatorModal" class="modal-overlay">
                    <div class="modal-box" style="max-width: 550px;">
                        <div class="modal-header">Start a Community Thread</div>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 20px;">
                            Publish visualization guidelines or ask coding queries to active students.
                        </p>
                        
                        <div id="newPostFormWrapper">
                            <div class="form-group">
                                <asp:TextBox ID="txtForumTopic" runat="server" CssClass="form-control" placeholder="Post Title"></asp:TextBox>
                            </div>
                            <div class="form-group">
                                <asp:TextBox ID="txtForumContent" runat="server" TextMode="MultiLine" Rows="4" CssClass="form-control" placeholder="Thoughts on alignment palettes..."></asp:TextBox>
                            </div>
                            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
                                <button type="button" class="btn btn-outline" style="width: auto; margin:0;" onclick="closeForumModal()">Cancel</button>
                                <asp:Button ID="btnSubmitPost" runat="server" Text="Publish Thread" CssClass="btn btn-primary" style="width: auto; margin:0;" OnClick="btnSubmitPost_Click" />
                            </div>
                        </div>
                    </div>
                </div>

            </main>

        </div>

    </form>

    <script src="script.js"></script>

    <%-- GLOBAL RUNTIME LOGIN STATE SYNC CORES --%>
    <script type="text/javascript">
        window.addEventListener('DOMContentLoaded', function () {
            syncGlobalNavigationState();
        });

        function syncGlobalNavigationState() {
            var isLoggedIn = localStorage.getItem('userLoggedIn');
            var savedName = localStorage.getItem('dashboardDisplayName') || "Zetty Adleena";
            
            var indicator = document.getElementById('roleIndicator');
            var loginTab = document.getElementById('navLoginItem');
            var logoutTab = document.getElementById('navLogoutItem');

            if (isLoggedIn === 'true') {
                // 1. Map personalized greeting context
                if (indicator) {
                    indicator.innerText = "Hello, " + savedName;
                    indicator.style.color = "#a5b4fc"; 
                    indicator.style.background = "rgba(99, 102, 241, 0.15)";
                }
                // 2. Toggle Navigation Link Sets
                if (loginTab) loginTab.style.display = 'none';
                if (logoutTab) logoutTab.style.display = 'block';
            } else {
                // Fallback Guest Layout parameters
                if (indicator) {
                    indicator.innerText = "Guest Account";
                    indicator.style.color = "#cbd5e1";
                    indicator.style.background = "rgba(255,255,255,0.05)";
                }
                if (loginTab) loginTab.style.display = 'block';
                if (logoutTab) logoutTab.style.display = 'none';
            }
        }

        // Clean logout engine routine to reset simulation back to pristine state
        function handleUserLogout() {
            localStorage.removeItem('userLoggedIn');
            // Keeps collected badges intact, but logs the profile out for demo reset
            window.location.href = 'Home.aspx';
        }
    </script>
</body>
</html>